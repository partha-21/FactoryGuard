# Copy this file to .env and adjust as needed.
POSTGRES_USER=factoryguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=factoryguard

# How many sensor messages the simulator sends per minute (normal = 100)
MESSAGES_PER_MINUTE=100

# FactoryGuard policy
# Below this many events per minute the app counts as unhealthy
GUARD_THRESHOLD=60
# How often FactoryGuard checks the app (seconds)
GUARD_CHECK_INTERVAL_SECONDS=5
# Grace time after each deployment before judging it (seconds)
GUARD_WARMUP_SECONDS=25
# Bad checks in a row before a rollback is triggered
GUARD_FAILURES_BEFORE_ROLLBACK=3
# Safety limit so rollback can never loop forever
GUARD_MAX_ROLLBACKS_PER_10_MIN=2
# Optional: a Slack/Discord/Teams webhook URL to receive alerts
GUARD_WEBHOOK_URL=

# Which network address the dashboard listens on. 127.0.0.1 = this computer only (safe default).
# 0.0.0.0 = reachable from other computers: read docs/SECURITY.md first.
GUARD_BIND=127.0.0.1
# Set to true only when the dashboard is served over HTTPS (so the session cookie is marked Secure)
GUARD_COOKIE_SECURE=false
